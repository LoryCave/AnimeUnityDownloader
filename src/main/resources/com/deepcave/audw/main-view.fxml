<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" maxHeight="450.0" maxWidth="700.0" minHeight="450.0" minWidth="700.0" prefHeight="450.0" prefWidth="700.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.deepcave.audw.controllers.MainController">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem fx:id="closeMenu" mnemonicParsing="false" onAction="#closeApp" text="Close" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Edit">
            <items>
                  <MenuItem fx:id="settingsMenu" mnemonicParsing="false" onAction="#openSettings" text="Impostazioni" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem fx:id="aboutMenu" mnemonicParsing="false" onAction="#openHelp" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <BorderPane prefHeight="420.0" prefWidth="675.0">
         <center>
            <Pane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <ImageView fx:id="selAnimeCover" fitHeight="200.0" fitWidth="135.0" layoutX="3.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true" style="-fx-border-color: red;" />
                  <Label fx:id="titleLabel" layoutX="153.0" layoutY="14.0" prefHeight="20.0" prefWidth="236.0">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Label>
                  <Label fx:id="typeLabel" layoutX="154.0" layoutY="39.0" prefHeight="17.0" prefWidth="282.0" />
                  <Label fx:id="plotLabel" alignment="TOP_LEFT" contentDisplay="RIGHT" layoutX="154.0" layoutY="61.0" prefHeight="276.0" prefWidth="287.0" wrapText="true" />
               </children>
               <BorderPane.margin>
                  <Insets left="8.0" />
               </BorderPane.margin></Pane>
         </center>
         <right>
            <ListView fx:id="sideList" onMouseClicked="#selectItem" prefHeight="355.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets right="8.0" />
               </BorderPane.margin></ListView>
         </right>
         <bottom>
            <Pane prefHeight="25.0" prefWidth="596.0" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </BorderPane.margin>
               <children>
                  <Button fx:id="downloadButton" disable="true" mnemonicParsing="false" onAction="#downloadAll" prefHeight="25.0" prefWidth="60.0" text="Scarica">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor></Button>
                  <Button fx:id="episodesButton" disable="true" layoutX="68.0" mnemonicParsing="false" onAction="#showEpisodes" prefHeight="25.0" prefWidth="60.0" text="Episodi">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor></Button>
                  <Label fx:id="dirLabel" alignment="CENTER_RIGHT" layoutX="144.0" layoutY="4.0" prefHeight="17.0" prefWidth="540.0" textAlignment="RIGHT">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
               </children>
            </Pane>
         </bottom>
         <top>
            <Pane prefHeight="25.0" prefWidth="684.0" BorderPane.alignment="CENTER">
               <children>
                  <TextField fx:id="searchKey" onAction="#onSearch" prefHeight="25.0" prefWidth="594.0">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </TextField>
                  <Button fx:id="searchButton" layoutX="609.0" mnemonicParsing="false" onAction="#onSearch" prefHeight="25.0" prefWidth="75.0" text="Cerca">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor></Button>
               </children>
               <BorderPane.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" />
               </BorderPane.margin>
            </Pane>
         </top>
      </BorderPane>
   </children>
</VBox>
